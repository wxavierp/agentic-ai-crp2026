# Copy this file to `.env` and fill in ONE provider's key.
#   cp .env.example .env            (macOS / Linux)
#   copy .env.example .env          (Windows)

# Which provider to use: openai | groq | anthropic | google
LLM_PROVIDER=openai

# Optional: override the default model for your provider
# LLM_MODEL=gpt-4o-mini

# --- Put a key for the provider you chose above ---
OPENAI_API_KEY=your_openai_api_key_here

# Free tiers (great for this course):
# Groq   -> https://console.groq.com
# GROQ_API_KEY=your_groq_api_key_here

# Google -> https://aistudio.google.com/apikey
# GOOGLE_API_KEY=your_google_api_key_here

# Anthropic -> https://console.anthropic.com
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
